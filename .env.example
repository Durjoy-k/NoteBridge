PORT=4000
JWT_SECRET=replace-this-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notebridge
VITE_API_URL=http://localhost:4000
# Comma-separated university domains. Example: cse.university.edu,university.edu
# Leave blank locally to allow common academic domains (.edu, .ac.uk, .ac.bd, .edu.bd).
UNIVERSITY_EMAIL_DOMAINS=
# Optional real email delivery through Resend. Without this, the code is printed by the local API.
RESEND_API_KEY=
EMAIL_FROM=NoteBridge <onboarding@resend.dev>
